  "contextual_correction_rules": {
    "_description": "基于上下文的语义纠错规则 — 当ASR输出的相邻术语组合不符合医学常识时触发",
    "rules": [
      {
        "id": "CTX-001",
        "if_asr_output": "肝{XX} 回声{YY}",
        "then_expect": "肝脏 回声均匀",
        "frequency_in_his": 2288,
        "note": "肝+回声有2,288处标准表达，若ASR输出非标准词替换"
      },
      {
        "id": "CTX-002",
        "if_asr_output": "{XX}内未见{YY}血流信号",
        "then_expect": "实质内未见异常血流信号",
        "frequency_in_his": 4437,
        "note": "血流信号是最常见的排除项，前文应为脏器实质"
      },
      {
        "id": "CTX-003",
        "if_asr_output": "多普勒{XX}检查见",
        "then_expect": "多普勒超声检查见",
        "frequency_in_his": 2331,
        "note": "多普勒后99%接'超声检查见'"
      },
      {
        "id": "CTX-004",
        "if_asr_output": "肝内{XX}管{YY}扩张",
        "then_expect": [
          "肝内胆管不扩张",
          "肝内外胆管扩张"
        ],
        "frequency_in_his": "2346(不扩张) vs 很少(扩张)",
        "note": "体检报告中胆管扩张极为罕见，ASR若输出'扩张'需高置信度确认"
      },
      {
        "id": "CTX-005",
        "if_asr_output": "{XX}周围未见{YY}",
        "then_expect": "胰腺周围未见占位性病变",
        "frequency_in_his": 2350,
        "note": "'周围未见'前文几乎总是'胰腺'或'附件'"
      },
      {
        "id": "CTX-006",
        "if_asr_output": "被膜{XX}",
        "then_expect": "包膜光滑",
        "frequency_in_his": "包膜=4639 vs 被膜=2358",
        "note": "HIS中存在'被膜光滑'的变体写法(2,358次)，应统一为'包膜光滑'"
      },
      {
        "id": "CTX-007",
        "if_asr_output": "回声{XX}",
        "then_most_likely": "回声均匀",
        "stats": {
          "均匀": 3508,
          "不均匀": 377,
          "增强": 132,
          "增粗/增强": 67
        },
        "note": "均匀:不均匀 ≈ 9:1，ASR若识别不明确时优先选'均匀'"
      }
    ]
  },
