{
  "description": "超声恶性高危征象黑名单规则库 — 检测到任意征象自动标注【高危】并建议进一步检查",
  "version": "2025",
  "rules": [
    {
      "id": "HR-001",
      "keywords": ["砂砾样钙化", "细沙样钙化", "微钙化簇", "点状微钙化"],
      "risk_level": "极高危",
      "rule": "甲状腺/乳腺结节内砂砾样钙化，是恶性肿瘤的典型特征",
      "action": "立即进一步检查，建议穿刺活检"
    },
    {
      "id": "HR-002",
      "keywords": ["毛刺征", "边缘毛糙", "边界不清", "浸润性边缘"],
      "risk_level": "高危",
      "rule": "结节边缘呈毛刺状/边界模糊，提示恶性浸润性生长",
      "action": "穿刺活检"
    },
    {
      "id": "HR-003",
      "keywords": ["内部血流信号丰富", "血供增多", "丰富血流", "穿支血流"],
      "risk_level": "高危",
      "rule": "结节内血流信号丰富，提示肿瘤新生血管形成",
      "action": "超声造影/穿刺活检"
    },
    {
      "id": "HR-004",
      "keywords": ["包膜不完整", "包膜浸润", "包膜突破", "包膜中断"],
      "risk_level": "极高危",
      "rule": "结节包膜不完整或突破包膜，提示恶性肿瘤已侵犯周围组织",
      "action": "立即手术评估"
    },
    {
      "id": "HR-005",
      "keywords": ["纵横比>1", "纵横比大于1", "直立位生长", "垂直位"],
      "risk_level": "高危",
      "rule": "甲状腺结节纵横比大于1，是甲状腺乳头状癌的典型特征",
      "action": "FNAB穿刺"
    },
    {
      "id": "HR-006",
      "keywords": ["微钙化", "点状钙化", "细小钙化"],
      "risk_level": "高危",
      "rule": "结节内多发微钙化，是恶性肿瘤的常见征象",
      "action": "进一步排查"
    },
    {
      "id": "HR-007",
      "keywords": ["淋巴结肿大", "淋巴结形态异常", "淋巴门结构消失", "淋巴结皮髓质分界不清"],
      "risk_level": "高危",
      "rule": "引流区域淋巴结肿大/形态异常，提示肿瘤淋巴结转移",
      "action": "全面评估，淋巴结穿刺"
    },
    {
      "id": "HR-008",
      "keywords": ["后方回声衰减", "声影", "后方声衰减"],
      "risk_level": "中高危",
      "rule": "结节后方回声衰减，提示结节质地坚硬，恶性风险较高",
      "action": "密切随访或穿刺活检"
    },
    {
      "id": "HR-009",
      "keywords": ["分叶状", "不规则形", "形态不规则", "分叶"],
      "risk_level": "中高危",
      "rule": "结节形态呈分叶状/不规则形，是恶性肿瘤常见形态特征",
      "action": "密切随访"
    },
    {
      "id": "HR-010",
      "keywords": ["导管扩张伴占位", "导管内占位", "导管内乳头状"],
      "risk_level": "中高危",
      "rule": "乳腺导管扩张伴导管内占位，提示导管内肿瘤",
      "action": "乳管镜检查"
    },
    {
      "id": "HR-011",
      "keywords": ["胰管扩张全程", "胆管扩张全程", "双管征"],
      "risk_level": "中高危",
      "rule": "胰管/胆管全程扩张>6mm，提示胰腺/胆道肿瘤梗阻",
      "action": "增强CT/MRI检查"
    },
    {
      "id": "HR-012",
      "keywords": ["肾皮质变薄伴积水", "肾盂积水重度"],
      "risk_level": "中高危",
      "rule": "肾脏皮质变薄伴肾盂积水，提示尿路梗阻",
      "action": "排查肿瘤、结石等病因"
    },
    {
      "id": "HR-013",
      "keywords": ["子宫内膜增厚伴回声不均", "内膜回声不均", "内膜异常增厚"],
      "risk_level": "中高危",
      "rule": "育龄期/绝经后子宫内膜增厚伴回声不均，需排查内膜增生/内膜癌",
      "action": "宫腔镜检查/诊刮"
    },
    {
      "id": "HR-014",
      "keywords": ["卵巢实性占位伴腹水", "卵巢囊实性占位", "大量腹水"],
      "risk_level": "极高危",
      "rule": "卵巢实性/囊实性占位伴大量腹水，高度提示卵巢恶性肿瘤",
      "action": "立即全面检查，CA-125+增强CT"
    },
    {
      "id": "HR-015",
      "keywords": ["前列腺外周带低回声", "前列腺外周带结节"],
      "risk_level": "高危",
      "rule": "前列腺外周带低回声结节，是前列腺癌的典型征象",
      "action": "PSA检查+穿刺活检"
    },
    {
      "id": "HR-016",
      "keywords": ["极低回声实性结节", "甲状腺极低回声"],
      "risk_level": "高危",
      "rule": "甲状腺极低回声实性结节，恶性风险显著增高",
      "action": "FNAB穿刺"
    },
    {
      "id": "HR-017",
      "keywords": ["钙化伴声影", "粗大钙化伴占位"],
      "risk_level": "中高危",
      "rule": "占位内粗大钙化+声影，需警惕恶性可能",
      "action": "超声造影或穿刺"
    },
    {
      "id": "HR-018",
      "keywords": ["肝内低回声占位伴晕圈征", "肝内占位周边低回声晕"],
      "risk_level": "高危",
      "rule": "肝脏低回声占位伴周边低回声晕圈征，高度怀疑肝细胞癌",
      "action": "增强CT/MRI+AFP"
    },
    {
      "id": "HR-019",
      "keywords": ["胆囊壁不规则增厚伴占位", "胆囊内固定实性占位"],
      "risk_level": "高危",
      "rule": "胆囊壁不规则增厚伴腔内固定实性占位，高度怀疑胆囊癌",
      "action": "增强CT/MRI+外科评估"
    },
    {
      "id": "HR-020",
      "keywords": ["肾占位伴假包膜", "肾肿瘤突破包膜", "肾静脉癌栓"],
      "risk_level": "极高危",
      "rule": "肾脏占位突破假包膜或肾静脉癌栓形成，提示肾细胞癌进展",
      "action": "泌尿外科立即手术评估"
    }
  ]
}
