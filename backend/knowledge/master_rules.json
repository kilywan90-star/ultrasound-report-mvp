      },
      {
        "pattern": "(?:中?孕|四维|排畸|彩超|停经|晚期|中期|早期)\\s*(\\d{2})\\s*[周Ww]",
        "field": "_ga_single"
      },
      {
        "pattern": "(?:约|大概|左右|相当于?|超声孕?)\\s*(\\d{2})\\s*[周Ww]",
        "field": "_ga_approx"
      },
      {
        "pattern": "(?:^|[^0-9,.])(\\d{2})\\s*[周Ww]",
        "field": "_ga_num"
      }
    ],
    "context_filters": {
      "skip_after_keywords": [
