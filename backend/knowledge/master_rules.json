    "fetal_ga_fuzzy": [
      {
        "pattern": "(?:中?孕|四维|排畸|彩超|停经|晚期|中期|早期).*?(\\d{2})\\s*[-~～到至为]\\s*(\\d{2})(?:\\s*[周Ww])?",
