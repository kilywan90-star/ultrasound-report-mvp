        "field": "_hl"
      },
      {
        "pattern": "HL\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_hl"
      },
      {
        "pattern": "(?:胎心|胎心率|心率|心跳|FHR?)\\s*[：:=]?\\s*(\\d{2,3})",
        "field": "_hr"
      },
      {
        "pattern": "(\\d{2,3})\\s*(?:次|ci)?\\s*[/／]?\\s*分",
        "field": "_hr"
      },
      {
        "pattern": "羊水指数\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_afi"
      },
      {
        "pattern": "AFI\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_afi"
      },
      {
        "pattern": "羊水(?:最大)?(?:平段|深度|暗区)\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_afv"
      },
      {
        "pattern": "(?:胎儿|估测)?体重\\s*[：:=]?\\s*(\\d+)\\s*(?:±\\s*\\d+)?\\s*(?:克|g)?",
        "field": "_efw"
      },
      {
        "pattern": "EFW\\s*[：:=]?\\s*(\\d+)",
        "field": "_efw"
      },
      {
        "pattern": "(?:脐动?脉?|脐带)?\\s*(?:S\\s*/\\s*D|SD)[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_ua_sd"
      },
      {
        "pattern": "(?:脐动?脉?|脐带)?\\s*RI\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_ua_ri"
      },
      {
        "pattern": "(?:脐动?脉?|脐带)?\\s*PI\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_ua_pi"
      },
      {
        "pattern": "(?:脐动?脉?|脐带)?\\s*Vmax\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_ua_vmax"
      },
      {
        "pattern": "小脑横径\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_tcd"
      },
      {
        "pattern": "鼻骨(?:约)?\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_nasal_bone"
      },
      {
        "pattern": "足长\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_foot_len"
      },
      {
        "pattern": "宫颈(?:管)?长(?:约)?\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_cervix_len"
      },
      {
        "pattern": "胎盘厚(?:度)?\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
