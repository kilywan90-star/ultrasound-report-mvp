    "fetal_ga_explicit": [
      {
        "pattern": "[四4][维維]\\s*(\\d{2})\\s*[-~～到至为]\\s*(\\d{2})",
        "priority": 100
      },
      {
        "pattern": "中[晚]?孕\\s*\\D{0,4}(\\d{2})\\s*[-~～到至为]\\s*(\\d{2})",
