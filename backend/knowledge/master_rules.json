        "field": "_af_q1"
      },
      {
        "pattern": "右上\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
        "field": "_af_q2"
      },
      {
        "pattern": "左上\\s*[：:=]?\\s*(\\d+(?:\\.\\d+)?)",
