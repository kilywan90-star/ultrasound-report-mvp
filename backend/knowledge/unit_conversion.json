{
  "kg_to_g": {
    "pattern": "(\\d+(?:\\.\\d+)?)\\s*公斤",
    "replace": "\u0001*1000克",
    "type": "multiply",
    "factor": 1000
  },
  "gongfen_to_cm": {
    "pattern": "(\\d+(?:\\.\\d+)?)\\s*公分",
    "replace": "\u0001cm"
  },
  "gongli_to_mm": {
    "pattern": "(\\d+(?:\\.\\d+)?)\\s*公厘",
    "replace": "\u0001mm"
  },
  "haomi_to_mm": {
    "pattern": "(\\d+(?:\\.\\d+)?)\\s*(?:豪|毫)米",
    "replace": "\u0001mm"
  },
  "limi_to_cm": {
    "pattern": "(\\d+(?:\\.\\d+)?)\\s*(?:离|厘)米",
    "replace": "\u0001cm"
  },
  "mm_suffix": {
    "pattern": "(\\d+)毫米",
    "replace": "\u0001mm"
  },
  "cm_suffix": {
    "pattern": "(\\d+)厘米",
    "replace": "\u0001cm"
  },
  "ASR_space_RI": {
    "pattern": "[Rr]\\s*[Ii]\\s*值",
    "replace": "RI"
  },
  "ASR_space_PI": {
    "pattern": "[TtPp]\\s*[Ii]\\s*值",
    "replace": "PI"
  },
  "ASR_space_SD": {
    "pattern": "[Ss]\\s*[Dd]\\s*值",
    "replace": "S/D"
  },
  "mian_to_duan": {
    "pattern": "平面",
    "replace": "平段"
  }
}